{
  "key": "group_page_sections",
  "title": "Page Sections",
  "fields": [
    {
      "key": "field_page_sections",
      "label": "Page Sections",
      "name": "page_sections",
      "type": "flexible_content",
      "instructions": "",
      "required": 0,
      "conditional_logic": 0,
      "wrapper": {
        "width": "",
        "class": "",
        "id": ""
      },
      "layouts": [
        {
          "key": "layout_hero",
          "name": "hero",
          "label": "Hero",
          "display": "block",
          "sub_fields": [
            {
              "key": "field_hero_heading",
              "label": "Heading",
              "name": "heading",
              "type": "text",
              "required": 1
            },
            {
              "key": "field_hero_subheading",
              "label": "Subheading",
              "name": "subheading",
              "type": "textarea"
            },
            {
              "key": "field_hero_cta_buttons",
              "label": "CTA Buttons",
              "name": "cta_buttons",
              "type": "repeater",
              "button_label": "Add Button",
              "sub_fields": [
                {
                  "key": "field_hero_button_text",
                  "label": "Button Text",
                  "name": "button_text",
                  "type": "text"
                },
                {
                  "key": "field_hero_button_link",
                  "label": "Button Link",
                  "name": "button_link",
                  "type": "text"
                },
                {
                  "key": "field_hero_button_style",
                  "label": "Button Style",
                  "name": "button_style",
                  "type": "select",
                  "choices": {
                    "primary": "Primary (Filled)",
                    "secondary": "Secondary (Outline)"
                  }
                }
              ]
            },
            {
              "key": "field_hero_bg_image",
              "label": "Background/Dashboard Illustration",
              "name": "bg_image",
              "type": "image",
              "return_format": "id"
            },
            {
              "key": "field_hero_avatars",
              "label": "Avatar Photos (3 max)",
              "name": "avatars",
              "type": "repeater",
              "button_label": "Add Avatar",
              "max": 3,
              "sub_fields": [
                {
                  "key": "field_hero_avatar_image",
                  "label": "Avatar Image",
                  "name": "avatar_image",
                  "type": "image",
                  "return_format": "id"
                }
              ]
            },
            {
              "key": "field_hero_trust_counter_value",
              "label": "Trust Counter Value (e.g. 525k+)",
              "name": "trust_counter_value",
              "type": "text"
            },
            {
              "key": "field_hero_trust_counter_label",
              "label": "Trust Counter Label (e.g. People trust us)",
              "name": "trust_counter_label",
              "type": "text"
            },
            {
              "key": "field_hero_trusted_by_label",
              "label": "Trusted By Label",
              "name": "trusted_by_label",
              "type": "text",
              "default_value": "Trusted by leading companies"
            },
            {
              "key": "field_hero_trusted_logos",
              "label": "Trusted By Logos (4 max)",
              "name": "trusted_logos",
              "type": "repeater",
              "button_label": "Add Logo",
              "max": 4,
              "sub_fields": [
                {
                  "key": "field_hero_logo_image",
                  "label": "Logo Image",
                  "name": "logo_image",
                  "type": "image",
                  "return_format": "id"
                }
              ]
            },
            {
              "key": "field_hero_pay_widget_amount",
              "label": "Pay Widget Amount (e.g. $60.47K)",
              "name": "pay_widget_amount",
              "type": "text"
            },
            {
              "key": "field_hero_pay_widget_period",
              "label": "Pay Widget Period (e.g. /week)",
              "name": "pay_widget_period",
              "type": "text"
            },
            {
              "key": "field_hero_pay_widget_blurb",
              "label": "Pay Widget Description",
              "name": "pay_widget_blurb",
              "type": "textarea"
            },
            {
              "key": "field_hero_pay_widget_button_text",
              "label": "Pay Widget Button Text",
              "name": "pay_widget_button_text",
              "type": "text",
              "default_value": "Pay"
            }
          ]
        },
        {
          "key": "layout_feature_split",
          "name": "feature_split",
          "label": "Feature Split (Two-Column)",
          "display": "block",
          "sub_fields": [
            {
              "key": "field_fs_heading",
              "label": "Heading",
              "name": "heading",
              "type": "text"
            },
            {
              "key": "field_fs_body",
              "label": "Body Text",
              "name": "body",
              "type": "textarea"
            },
            {
              "key": "field_fs_cta_text",
              "label": "CTA Button Text",
              "name": "cta_text",
              "type": "text"
            },
            {
              "key": "field_fs_cta_link",
              "label": "CTA Button Link",
              "name": "cta_link",
              "type": "text"
            },
            {
              "key": "field_fs_reverse",
              "label": "Reverse Layout (text right, image left)",
              "name": "reverse",
              "type": "true_false"
            },
            {
              "key": "field_fs_mockup_type",
              "label": "Mockup Type",
              "name": "mockup_type",
              "type": "select",
              "choices": {
                "transaction_list": "Transaction List",
                "counter_overlay": "Counter Overlay",
                "none": "None"
              },
              "default_value": "transaction_list"
            },
            {
              "key": "field_fs_mockup_image",
              "label": "Mockup Image",
              "name": "mockup_image",
              "type": "image",
              "return_format": "id"
            },
            {
              "key": "field_fs_profile_avatar",
              "label": "Profile Avatar",
              "name": "profile_avatar",
              "type": "image",
              "return_format": "id",
              "conditional_logic": [
                [
                  {
                    "field": "field_fs_mockup_type",
                    "operator": "==",
                    "value": "transaction_list"
                  }
                ]
              ]
            },
            {
              "key": "field_fs_profile_name",
              "label": "Profile Name",
              "name": "profile_name",
              "type": "text",
              "conditional_logic": [
                [
                  {
                    "field": "field_fs_mockup_type",
                    "operator": "==",
                    "value": "transaction_list"
                  }
                ]
              ]
            },
            {
              "key": "field_fs_profile_status",
              "label": "Profile Status (e.g. Online)",
              "name": "profile_status",
              "type": "text",
              "conditional_logic": [
                [
                  {
                    "field": "field_fs_mockup_type",
                    "operator": "==",
                    "value": "transaction_list"
                  }
                ]
              ]
            },
            {
              "key": "field_fs_message_text",
              "label": "Message Text",
              "name": "message_text",
              "type": "textarea",
              "conditional_logic": [
                [
                  {
                    "field": "field_fs_mockup_type",
                    "operator": "==",
                    "value": "transaction_list"
                  }
                ]
              ]
            },
            {
              "key": "field_fs_transaction_items",
              "label": "Transactions",
              "name": "transaction_items",
              "type": "repeater",
              "button_label": "Add Transaction",
              "conditional_logic": [
                [
                  {
                    "field": "field_fs_mockup_type",
                    "operator": "==",
                    "value": "transaction_list"
                  }
                ]
              ],
              "sub_fields": [
                {
                  "key": "field_fs_tx_icon",
                  "label": "Icon",
                  "name": "icon",
                  "type": "image",
                  "return_format": "id"
                },
                {
                  "key": "field_fs_tx_title",
                  "label": "Title",
                  "name": "title",
                  "type": "text"
                },
                {
                  "key": "field_fs_tx_category",
                  "label": "Category",
                  "name": "category",
                  "type": "text"
                },
                {
                  "key": "field_fs_tx_amount",
                  "label": "Amount",
                  "name": "amount",
                  "type": "text"
                },
                {
                  "key": "field_fs_tx_date",
                  "label": "Date",
                  "name": "date",
                  "type": "text"
                }
              ]
            },
            {
              "key": "field_fs_counter_items",
              "label": "Counters",
              "name": "counter_items",
              "type": "repeater",
              "button_label": "Add Counter",
              "max": 2,
              "conditional_logic": [
                [
                  {
                    "field": "field_fs_mockup_type",
                    "operator": "==",
                    "value": "counter_overlay"
                  }
                ]
              ],
              "sub_fields": [
                {
                  "key": "field_fs_counter_value",
                  "label": "Value",
                  "name": "value",
                  "type": "text"
                },
                {
                  "key": "field_fs_counter_unit",
                  "label": "Unit (e.g. %)",
                  "name": "unit",
                  "type": "text"
                },
                {
                  "key": "field_fs_counter_label",
                  "label": "Label",
                  "name": "label",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "key": "layout_global_presence",
